{
  "name": "gravity-duel-playtest",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --outDir web-v0.10.0",
    "build:offline": "node build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "dev:crazygames": "vite --mode crazygames --host 127.0.0.1 --port 5175",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir crazygames-v0.10.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
